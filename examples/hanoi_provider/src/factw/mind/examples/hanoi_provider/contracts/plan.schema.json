{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "disk": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "target": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "disk",
          "target"
        ],
        "additionalProperties": false
      },
      "maxItems": 1
    },
    "invocation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "primitive": {
              "const": "move"
            },
            "bindings": {
              "type": "object",
              "properties": {
                "disk": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "disk"
                    },
                    "key": {
                      "enum": [
                        "disk_0",
                        "disk_1",
                        "disk_2"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "key"
                  ],
                  "additionalProperties": false
                },
                "destination": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "peg"
                    },
                    "key": {
                      "enum": [
                        "peg_0",
                        "peg_1",
                        "peg_2"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "key"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "disk",
                "destination"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "primitive",
            "bindings"
          ],
          "additionalProperties": false
        }
      ]
    },
    "remaining_moves": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "expanded_states": {
      "type": "integer",
      "minimum": 0,
      "maximum": 27
    }
  },
  "required": [
    "actions",
    "invocation",
    "remaining_moves",
    "expanded_states"
  ],
  "additionalProperties": false
}
